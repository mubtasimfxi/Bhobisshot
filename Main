              {["রবি","সোম","মঙ্গল","বুধ","বৃহ","শুক্র","শনি"].map(d => (
                <div key={d} style={{ padding:"6px 0", textAlign:"center", fontSize:10, fontFamily:"'Hind Siliguri',sans-serif", fontWeight:700, color:"#888" }}>{d}</div>
              ))}
              {Array.from({length:30}).map((_,i) => {
                const status = i===2||i===15?"absent":i===8?"late":i>=5&&i<7?"holiday":"present";
                return (
                  <div key={i} style={{ padding:6, textAlign:"center", borderRadius:6, background:status==="absent"?C.dangerBg:status==="late"?C.warningBg:status==="holiday"?C.muted:C.successBg, fontSize:11, fontFamily:"'JetBrains Mono',monospace", color:status==="absent"?C.danger:status==="late"?C.warning:status==="holiday"?"#999":C.success, fontWeight:600, cursor:"default" }}>
                    {i+1}
                  </div>
                );
              })}
            </div>
            <div style={{ display:"flex", gap:14, marginTop:12, flexWrap:"wrap" }}>
              {[{label:lang==="bn"?"উপস্থিত":"Present",color:C.successBg,tc:C.success},{label:lang==="bn"?"অনুপস্থিত":"Absent",color:C.dangerBg,tc:C.danger},{label:lang==="bn"?"দেরি":"Late",color:C.warningBg,tc:C.warning},{label:lang==="bn"?"ছুটি":"Holiday",color:C.muted,tc:"#888"}].map(l => (
                <div key={l.label} style={{ display:"flex", gap:4, alignItems:"center" }}>
                  <div style={{ width:12, height:12, borderRadius:3, background:l.color, border:`1px solid ${l.tc}33` }} />
                  <span style={{ fontSize:11, color:l.tc, fontFamily:"'Hind Siliguri',sans-serif" }}>{l.label}</span>
