            <Tooltip content={<CustomTooltip />} />
            <Line type="monotone" dataKey="avg" name={lang==="bn"?"শ্রেণীর গড়":"Class Avg"} stroke={C.gold} strokeWidth={2.5} dot={{ r:4 }} />
