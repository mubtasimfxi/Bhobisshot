                    <td key={i} title={`${s.name} — ${sc}/100`}
                      style={{ padding:"10px 6px", background:bg, borderRadius:6, textAlign:"center", fontFamily:"'JetBrains Mono',monospace", fontSize:13, fontWeight:700, color:textColor, cursor:"pointer" }}>
                      {sc}
                    </td>
                  );
                })}
              </tr>
            );
          })}
        </tbody>
      </table>
      <div style={{ display:"flex", gap:12, marginTop:12, flexWrap:"wrap" }}>
        {[{label:">85",color:C.success},{label:"70-84",color:C.emerald},{label:"55-69",color:C.gold},{label:"40-54",color:C.warning},{label:"<40",color:C.danger}].map(l => (
