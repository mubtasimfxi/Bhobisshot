          <div style={{ marginTop:32, padding:"16px 24px", background:"rgba(255,255,255,0.06)", borderRadius:12, backdropFilter:"blur(10px)", border:"1px solid rgba(255,255,255,0.1)" }}>
            <p style={{ color:"rgba(255,255,255,0.7)", fontSize:14, margin:0, fontStyle:"italic" }}>
              {lang==="bn" ? '"শিক্ষার আলো, সবার জন্য"' : '"Education for All"'}
            </p>
          </div>
          <div style={{ marginTop:24, display:"flex", flexDirection:"column", gap:8 }}>
            {["৪ কোটি ২০ লক্ষ শিক্ষার্থী","১,৫২,০০০ বিদ্যালয়","৮টি বিভাগ · ৬৪টি জেলা"].map((s,i) => (
              <div key={i} style={{ display:"flex", alignItems:"center", gap:8, color:"rgba(255,255,255,0.55)", fontSize:12 }}>
                <div style={{ width:4, height:4, borderRadius:"50%", background:C.gold }} />
                {s}
              </div>
            ))}
          </div>
        </div>
      </div>
      {/* Right panel */}
      <div style={{ flex:1, background:C.warm, display:"flex", flexDirection:"column", alignItems:"center", justifyContent:"center", padding:48, position:"relative" }}>
        {/* Lang toggle top right */}
        <div style={{ position:"absolute", top:24, right:24, display:"flex", background:C.muted, borderRadius:9999, padding:3 }}>
          {["en","bn"].map(l => (
            <button key={l} onClick={() => setLang(l)}
              style={{ padding:"4px 12px", borderRadius:9999, border:"none", background: lang===l ? C.forest : "transparent", color: lang===l ? "#fff" : "#666", fontSize:12, fontWeight:600, cursor:"pointer", fontFamily:"'Hind Siliguri',sans-serif" }}>
              {l==="en"?"EN":"বাং"}
            </button>
          ))}
        </div>
        <div style={{ width:"100%", maxWidth:480 }}>
          <h1 style={{ fontFamily:"'Sora',sans-serif", fontSize:26, fontWeight:700, color:C.dark, marginBottom:6 }}>
            {lang==="bn" ? "আপনার অ্যাকাউন্টে প্রবেশ করুন" : "Sign In to Your Account"}
          </h1>
          <p style={{ color:"#888", fontSize:13, marginBottom:28 }}>
            {lang==="bn" ? "আপনার ভূমিকা নির্বাচন করুন" : "Select your role to continue"}
          </p>
          {/* Role cards */}
          <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:10, marginBottom:24 }}>
            {roles.map(r => (
              <button key={r.id} onClick={() => setSelectedRole(r.id)}
                style={{ padding:"12px 14px", borderRadius:10, border:`2px solid ${selectedRole===r.id ? C.forest : C.muted}`, background: selectedRole===r.id ? C.successBg : C.paper, cursor:"pointer", display:"flex", gap:10, alignItems:"center", transition:"all 0.15s" }}>
                <span style={{ fontSize:20 }}>{r.icon}</span>
                <div style={{ textAlign:"left" }}>
                  <div style={{ fontFamily:"'Hind Siliguri',sans-serif", fontSize:13, fontWeight:700, color: selectedRole===r.id ? C.forest : C.dark }}>{lang==="bn" ? r.bn : r.en}</div>
                </div>
                {selectedRole===r.id && <span style={{ marginLeft:"auto", color:C.forest }}>✓</span>}
              </button>
            ))}
          </div>
          {/* Email/pass */}
          <div style={{ display:"flex", flexDirection:"column", gap:12, marginBottom:20 }}>
            <div>
              <label style={{ fontSize:13, fontWeight:600, color:C.dark, display:"block", marginBottom:6, fontFamily:"'Hind Siliguri',sans-serif" }}>{lang==="bn"?"ইমেইল":"Email"}</label>
              <input defaultValue={roles.find(r=>r.id===selectedRole)?.email} style={{ width:"100%", padding:"11px 14px", borderRadius:8, border:`1.5px solid ${C.muted}`, fontSize:14, background:C.paper, color:C.dark, boxSizing:"border-box", fontFamily:"'Plus Jakarta Sans',sans-serif" }} />
            </div>
            <div>
              <label style={{ fontSize:13, fontWeight:600, color:C.dark, display:"block", marginBottom:6, fontFamily:"'Hind Siliguri',sans-serif" }}>{lang==="bn"?"পাসওয়ার্ড":"Password"}</label>
              <input type="password" defaultValue="demo123" style={{ width:"100%", padding:"11px 14px", borderRadius:8, border:`1.5px solid ${C.muted}`, fontSize:14, background:C.paper, color:C.dark, boxSizing:"border-box", fontFamily:"'Plus Jakarta Sans',sans-serif" }} />
            </div>
          </div>
          <button onClick={() => onLogin(selectedRole, lang)}
            style={{ width:"100%", padding:"13px", background:`linear-gradient(135deg, ${C.forest}, ${C.emerald})`, color:"#fff", border:"none", borderRadius:10, fontSize:15, fontWeight:700, cursor:"pointer", fontFamily:"'Hind Siliguri',sans-serif", boxShadow:"0 4px 20px rgba(0,92,75,0.3)", marginBottom:12 }}>
            {lang==="bn" ? "প্রবেশ করুন →" : "Sign In →"}
          </button>
          <p style={{ textAlign:"center", fontSize:11, color:"#aaa" }}>
            {lang==="bn" ? "ডেমো অ্যাকাউন্ট: demo123" : "Demo password: demo123"}
          </p>
        </div>
      </div>
    </div>
  );
};

// ============================================================
// MAIN APP
// ============================================================
export default function App() {
  const [session, setSession] = useState(null);
  const [lang, setLang] = useState("bn");
  const [activeTab, setActiveTab] = useState("overview");
  const [collapsed, setCollapsed] = useState(false);
  const [showNotifs, setShowNotifs] = useState(false);
  const [selectedChild, setSelectedChild] = useState(0);
  const [downloads, setDownloads] = useState([]);
  const [notifications] = useState([
    { id:1, icon:"📝", title:"নতুন মূল্যায়ন প্রকাশিত", time:"২ মিনিট আগে", read:false },
    { id:2, icon:"📢", title:"SSC পরীক্ষার নোটিশ", time:"১ ঘণ্টা আগে", read:false },
    { id:3, icon:"✅", title:"আপনার মূল্যায়ন মূল্যায়িত হয়েছে", time:"৩ ঘণ্টা আগে", read:true },
  ]);

  const children = [STUDENTS[0], STUDENTS[1]];
  const child = children[selectedChild];

  const handleLogin = (role, loginLang) => {
    setSession({ role, name: role==="student"?"আরিফ হোসেন":role==="parent"?"রোকেয়া বেগম":role==="teacher"?"ফাতেমা বেগম":role==="admin"?"প্রশাসক আহমেদ":"কর্মকর্তা রহমান" });
    setLang(loginLang || "bn");
    setActiveTab(role==="government"?"national":"overview");
  };

  const getPageTitle = () => {
    if (!session) return "";
    const role = session.role;
    const items = SIDEBAR_ITEMS[role] || [];
    const item = items.find(i => i.id === activeTab);
    return item ? (lang==="bn" ? item.labelBn : item.labelEn) : "";
  };

  if (!session) {
    return (
      <>
        <style>{`@import url('https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;600;700&family=Sora:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap'); * { box-sizing: border-box; margin: 0; padding: 0; }`}</style>
        <LoginPage onLogin={handleLogin} />
      </>
    );
  }

  const { role } = session;

  const renderContent = () => {
    // STUDENT
    if (role === "student") {
      if (activeTab === "overview") return <StudentOverview lang={lang} />;
      if (activeTab === "library") return <LibraryTab lang={lang} downloads={downloads} setDownloads={setDownloads} />;
      if (activeTab === "assessments") return <StudentAssessmentsTab lang={lang} />;
      if (activeTab === "cognitive") return (
        <div>
          <SectionTitle>{lang==="bn"?"জ্ঞান দক্ষতার বিশ্লেষণ":"Cognitive Skills Analysis"}</SectionTitle>
          <Card>
            <ResponsiveContainer width="100%" height={300}>
              <RadarChart data={COGNITIVE_DATA}>
                <PolarGrid stroke={C.muted} />
                <PolarAngleAxis dataKey="skill" tick={{ fontSize:12, fontFamily:"'Hind Siliguri',sans-serif" }} />
                <Radar name={lang==="bn"?"বর্তমান":"Current"} dataKey="current" stroke={C.forest} fill={C.forest} fillOpacity={0.25} />
                <Radar name={lang==="bn"?"পূর্ববর্তী":"Previous"} dataKey="previous" stroke={C.gold} fill={C.gold} fillOpacity={0.1} strokeDasharray="4 2" />
                <Legend />
              </RadarChart>
            </ResponsiveContainer>
          </Card>
          <div style={{ marginTop:16, display:"flex", flexDirection:"column", gap:10 }}>
            {COGNITIVE_DATA.map(d => (
              <Card key={d.skill} style={{ padding:"12px 16px" }}>
                <div style={{ display:"flex", justifyContent:"space-between", marginBottom:6 }}>
                  <span style={{ fontFamily:"'Hind Siliguri',sans-serif", fontSize:13, fontWeight:600 }}>{d.skill}</span>
                  <div style={{ display:"flex", gap:8 }}>
                    <span style={{ fontFamily:"'JetBrains Mono',monospace", fontSize:13, color:C.forest, fontWeight:700 }}>{d.current}</span>
                    <span style={{ fontSize:11, color: d.current>d.previous?C.success:C.danger }}>{d.current>d.previous?"↑":"↓"}{Math.abs(d.current-d.previous)}</span>
                  </div>
                </div>
                <div style={{ height:6, background:C.muted, borderRadius:3 }}>
                  <div style={{ height:"100%", width:`${d.current}%`, background:C.forest, borderRadius:3 }} />
                </div>
              </Card>
            ))}
          </div>
        </div>
      );
      if (activeTab === "performance") return (
