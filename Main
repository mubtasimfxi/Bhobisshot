              <div style={{ height:"100%", width:`${e.pct}%`, background:e.pct>=80?C.success:e.pct>=50?C.warning:C.info, borderRadius:3, transition:"width 1s ease" }} />
            </div>
          </div>
        ))}
      </Card>
      {/* Admin Notes */}
      <Card>
        <SectionTitle>{lang==="bn"?"প্রশাসনিক নোট":"Admin Notes"}</SectionTitle>
        {[{ author:"বিদ্যালয় প্রশাসক", date:"১২ মার্চ ২০২৪", note:"নিয়মিত ক্লাস নেন এবং শিক্ষার্থীদের সাথে ভালো সম্পর্ক বজায় রাখেন।" }].map((n,i) => (
          <div key={i} style={{ padding:"10px 14px", background:C.warm, borderRadius:8, marginBottom:8 }}>
            <div style={{ display:"flex", gap:6, marginBottom:4 }}>
              <Badge color="navy">{n.author}</Badge>
              <span style={{ fontSize:11, color:"#999" }}>{n.date}</span>
            </div>
            <p style={{ fontFamily:"'Hind Siliguri',sans-serif", fontSize:13, margin:0, color:C.dark }}>{n.note}</p>
          </div>
        ))}
        {!readOnly && (
