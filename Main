    }

    return (
      <Card style={{ textAlign:"center", padding:60 }}>
        <div style={{ fontSize:40, marginBottom:12 }}>🚧</div>
        <div style={{ fontFamily:"'Hind Siliguri',sans-serif", fontSize:15, color:"#888" }}>{lang==="bn"?"শীঘ্রই আসছে":"Coming Soon"}</div>
