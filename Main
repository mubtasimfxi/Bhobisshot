              <textarea rows={4} placeholder={lang==="bn"?"নোটিশের বিস্তারিত বিবরণ...":"Notice body..."} style={{ padding:"10px 12px", borderRadius:6, border:`1px solid ${C.muted}`, fontSize:14, fontFamily:"'Hind Siliguri',sans-serif", resize:"vertical" }} />
