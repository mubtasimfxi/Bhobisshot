        {[{ sub:"গণিত", pct:90, level:"বিশেষজ্ঞ" },{ sub:"বিজ্ঞান", pct:65, level:"মধ্যবর্তী" },{ sub:"আইসিটি", pct:45, level:"শিক্ষানবিশ" }].map(e => (
