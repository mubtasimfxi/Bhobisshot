        </div>
        {/* Main */}
        <div style={{ flex:1, display:"flex", flexDirection:"column", overflow:"hidden" }}>
          <TopBar title={getPageTitle()} lang={lang} setLang={setLang} notifications={notifications} onNotifClick={() => setShowNotifs(s=>!s)} showNotifs={showNotifs} role={role} />
          {/* Parent child selector */}
          {role === "parent" && (
            <div style={{ background:C.paper, borderBottom:`1px solid ${C.muted}`, padding:"10px 24px", display:"flex", gap:10, alignItems:"center" }}>
              <span style={{ fontFamily:"'Hind Siliguri',sans-serif", fontSize:12, color:"#888", marginRight:4 }}>{lang==="bn"?"সন্তান:":"Child:"}</span>
              {children.map((c,i) => (
                <button key={c.id} onClick={() => setSelectedChild(i)}
                  style={{ display:"flex", gap:8, alignItems:"center", padding:"6px 14px", borderRadius:9999, border:`1.5px solid ${selectedChild===i?C.forest:C.muted}`, background: selectedChild===i ? C.successBg : "transparent", cursor:"pointer", fontFamily:"'Hind Siliguri',sans-serif", fontSize:13, fontWeight: selectedChild===i ? 700 : 400, color: selectedChild===i ? C.forest : "#555", transition:"all 0.15s" }}>
