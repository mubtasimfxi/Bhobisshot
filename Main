const PolicySimulation = ({ lang }) => {
  const [budget, setBudget] = useState({ training:100, infra:200, edtech:50, meals:150, connectivity:30 });
  const total = Object.values(budget).reduce((a,b)=>a+b,0);
  const scoreImpact = ((budget.training*0.015 + budget.edtech*0.018 + budget.infra*0.008)).toFixed(1);
  const dropoutReduction = ((budget.meals*0.012 + budget.connectivity*0.015 + budget.training*0.008)).toFixed(1);
  const studentsImpacted = Math.floor((budget.infra*800 + budget.connectivity*1200 + budget.edtech*600)/1000000*10)/10;

  return (
    <div>
      <SectionTitle badge={<AIBadge />}>{lang==="bn"?"নীতি সিমুলেশন":"Policy Simulation"}</SectionTitle>
      <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:20 }}>
        <Card>
          <h4 style={{ fontFamily:"'Hind Siliguri',sans-serif", fontSize:14, fontWeight:700, color:C.dark, marginBottom:16 }}>
            {lang==="bn"?"বাজেট বরাদ্দ":"Budget Allocation"} — <span style={{ color:C.forest, fontFamily:"'JetBrains Mono',monospace" }}>৳{total} {lang==="bn"?"কোটি":"Crore"}</span>
          </h4>
          {[
            { key:"training", label: lang==="bn"?"শিক্ষক প্রশিক্ষণ":"Teacher Training", max:500, color:C.forest },
            { key:"infra", label: lang==="bn"?"অবকাঠামো":"Infrastructure", max:1000, color:C.emerald },
            { key:"edtech", label: lang==="bn"?"EdTech":"EdTech & Digital", max:300, color:C.info },
            { key:"meals", label: lang==="bn"?"মিল কর্মসূচি":"Student Meals", max:400, color:C.gold },
            { key:"connectivity", label: lang==="bn"?"গ্রামীণ সংযোগ":"Rural Connectivity", max:200, color:"#A23B72" },
          ].map(s => (
            <div key={s.key} style={{ marginBottom:16 }}>
              <div style={{ display:"flex", justifyContent:"space-between", marginBottom:6 }}>
                <span style={{ fontFamily:"'Hind Siliguri',sans-serif", fontSize:13, fontWeight:600 }}>{s.label}</span>
                <span style={{ fontFamily:"'JetBrains Mono',monospace", fontSize:13, color:s.color, fontWeight:700 }}>৳{budget[s.key]} {lang==="bn"?"কোটি":"Cr"}</span>
              </div>
              <input type="range" min={0} max={s.max} value={budget[s.key]}
                onChange={e => setBudget(b => ({...b, [s.key]:parseInt(e.target.value)}))}
                style={{ width:"100%", accentColor:s.color, height:4, cursor:"pointer" }} />
              <div style={{ display:"flex", justifyContent:"space-between", fontSize:10, color:"#bbb", marginTop:2 }}>
                <span>০</span><span>{s.max}</span>
              </div>
            </div>
          ))}
        </Card>
        <div style={{ display:"flex", flexDirection:"column", gap:14 }}>
          <h4 style={{ fontFamily:"'Hind Siliguri',sans-serif", fontSize:14, fontWeight:700, color:C.dark, margin:0 }}>
            {lang==="bn"?"পূর্বাভাসিত প্রভাব":"Projected Impact"}
          </h4>
          {[
            { label: lang==="bn"?"স্কোর উন্নতি":"Score Improvement", value:`+${scoreImpact}%`, icon:"📈", color:C.success, bg:C.successBg },
            { label: lang==="bn"?"ঝরে পড়া হ্রাস":"Dropout Reduction", value:`-${dropoutReduction}%`, icon:"🎯", color:C.forest, bg:"#e8f5ee" },
            { label: lang==="bn"?"প্রভাবিত শিক্ষার্থী":"Students Impacted", value:`${studentsImpacted}M`, icon:"🎓", color:C.info, bg:C.infoBg },
            { label: lang==="bn"?"প্রশিক্ষিত শিক্ষক":"Teachers Trained", value:`${Math.floor(budget.training*8).toLocaleString()}`, icon:"👩‍🏫", color:C.gold, bg:C.warningBg },
          ].map((item,i) => (
            <div key={i} style={{ background:item.bg, borderRadius:10, padding:"14px 16px", border:`1px solid ${item.color}22`, display:"flex", gap:12, alignItems:"center" }}>
              <span style={{ fontSize:24 }}>{item.icon}</span>
              <div>
                <div style={{ fontFamily:"'JetBrains Mono',monospace", fontSize:22, fontWeight:700, color:item.color }}>{item.value}</div>
                <div style={{ fontFamily:"'Hind Siliguri',sans-serif", fontSize:12, color:"#666" }}>{item.label}</div>
              </div>
            </div>
          ))}
          <div style={{ padding:"12px 14px", background:C.warningBg, borderRadius:8, borderLeft:`3px solid ${C.gold}` }}>
            <div style={{ display:"flex", gap:6, alignItems:"center", marginBottom:4 }}>
              <AIBadge />
              <span style={{ fontFamily:"'Sora',sans-serif", fontSize:11, fontWeight:700, color:C.warning }}>AI বিশ্লেষণ</span>
            </div>
            <p style={{ fontFamily:"'Hind Siliguri',sans-serif", fontSize:12, color:C.warning, margin:0 }}>
              {lang==="bn" ? `শিক্ষক প্রশিক্ষণে ৳${budget.training} কোটি বিনিয়োগ সর্বোচ্চ ROI দেবে। গ্রামীণ সংযোগ বৃদ্ধিতে মনোযোগ দিলে ঝরে পড়া উল্লেখযোগ্যভাবে কমবে।` : `Investing ৳${budget.training}Cr in teacher training gives highest ROI. Focusing on rural connectivity will significantly reduce dropout rates.`}
            </p>
          </div>
        </div>
      </div>
    </div>
  );
};

