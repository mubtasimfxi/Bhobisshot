              <strong>মূল ঝুঁকি:</strong> ১০.১% ঝরে পড়ার হার জাতীয় গড়ের উপরে। বিশেষত তৃতীয় ও চতুর্থ শ্রেণীতে উপস্থিতি কম।<br/>
              <strong>সুপারিশ:</strong> (১) স্কুল মিল কর্মসূচি সম্প্রসারণ। (২) ৫০ জন অতিরিক্ত গণিত শিক্ষক নিয়োগ। (৩) মোবাইল লাইব্রেরি চালু।
            </div>
          </div>
        </div>
      );
      if (activeTab === "transfers") return (
        <div>
          <SectionTitle badge={<AIBadge />}>{lang==="bn"?"AI শিক্ষক বদলি সুপারিশ":"AI Transfer Recommendations"}</SectionTitle>
