              <BarChart data={[
                {div:"ঢাকা",amt:12000},{div:"চট্টগ্রাম",amt:8500},{div:"খুলনা",amt:5200},{div:"রাজশাহী",amt:4800},
                {div:"সিলেট",amt:4200},{div:"বরিশাল",amt:3100},{div:"রংপুর",amt:3600},{div:"ময়মনসিংহ",amt:600},
